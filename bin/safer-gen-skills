#!/usr/bin/env bash
# safer-gen-skills — render skills/<name>/SKILL.md from skills/<name>/SKILL.tmpl
#
# The .tmpl is the human-edited source. It contains the YAML frontmatter and
# modality-specific content. The generator inlines PRINCIPLES.core.md verbatim
# where {{> principles-core}} appears and stamps an AUTO-GENERATED marker right
# after the frontmatter so CI / humans can detect manual edits to the rendered
# file.
#
# Doctrine reaches a running skill in two layers. PRINCIPLES.core.md is the
# compressed craft floor, inlined into every skill so it is always in context.
# PRINCIPLES.md is the full doctrine, read by path at the plugin root when a
# call is close or the artifact is high-blast-radius. The older
# {{> principles}} directive inlined the full doctrine into all 16 skills,
# which cost ~8.4k duplicated lines; it is now a hard error naming this
# migration rather than a silent no-op.
#
# The retired {{> vendor-skill:<slug>}} directive inlined the sister codemod's
# skill bodies from a committed snapshot. The codemod ships those bodies in its
# npm package, so the wrapper skills now read them from the adopter's
# node_modules at runtime, where they cannot drift from the installed binary.
#
# Usage:
#   bin/safer-gen-skills                    # render every skills/*/SKILL.tmpl
#   bin/safer-gen-skills --check            # exit non-zero if any SKILL.md is stale
#
# The generator is idempotent.
set -euo pipefail

PLUGIN_DIR="$(cd "$(dirname "$0")/.." && pwd)"
PRINCIPLES_CORE_FILE="$PLUGIN_DIR/PRINCIPLES.core.md"
MARKER='<!-- AUTO-GENERATED from this directory'\''s SKILL.tmpl + PRINCIPLES.core.md. Do not edit; edit the .tmpl and regenerate via bin/safer-gen-skills. -->'

CHECK_ONLY=0

while [ $# -gt 0 ]; do
  case "$1" in
    --check) CHECK_ONLY=1; shift ;;
    -h|--help)
      cat <<'EOF'
safer-gen-skills — render skills/<name>/SKILL.md from skills/<name>/SKILL.tmpl

  bin/safer-gen-skills           render every skills/*/SKILL.tmpl
  bin/safer-gen-skills --check   exit non-zero if any SKILL.md is stale

The .tmpl is the human-edited source; SKILL.md is a generated artifact carrying
an AUTO-GENERATED marker. The one directive, {{> principles-core}}, inlines
PRINCIPLES.core.md. Rendering is idempotent.
EOF
      exit 0
      ;;
    *) echo "ERROR: unknown flag: $1" >&2; exit 1 ;;
  esac
done

[ -f "$PRINCIPLES_CORE_FILE" ] || { echo "ERROR: $PRINCIPLES_CORE_FILE not found" >&2; exit 1; }

render_one() {
  local tmpl="$1"
  awk \
    -v principles_file="$PRINCIPLES_CORE_FILE" \
    -v marker="$MARKER" \
    '
    BEGIN { fm = 0; injected = 0 }
    /^---$/ {
      print
      fm++
      if (fm == 2 && !injected) {
        print ""
        print marker
        injected = 1
      }
      next
    }
    /^\{\{> principles-core\}\}$/ {
      while ((getline line < principles_file) > 0) print line
      close(principles_file)
      next
    }
    { print }
  ' "$tmpl"
}

# The retired {{> principles}} directive inlined the full PRINCIPLES.md into
# every skill. A template still carrying it would render the directive line as
# literal text, so fail loud once, up front, and name the successor.
if legacy=$(grep -lF '{{> principles}}' "$PLUGIN_DIR"/skills/*/SKILL.tmpl 2>/dev/null); then
  echo "ERROR: retired {{> principles}} directive in:" >&2
  printf '  %s\n' $legacy >&2
  echo "Use {{> principles-core}} (inlines PRINCIPLES.core.md); reference PRINCIPLES.md by path for depth." >&2
  exit 1
fi

STALE=0
TOTAL=0

for tmpl in "$PLUGIN_DIR"/skills/*/SKILL.tmpl; do
  [ -f "$tmpl" ] || continue
  TOTAL=$((TOTAL + 1))
  out="${tmpl%/*}/SKILL.md"
  rendered=$(render_one "$tmpl")

  if [ "$CHECK_ONLY" -eq 1 ]; then
    # Byte-exact: command substitution strips trailing newlines on both sides,
    # so a string compare would call a SKILL.md differing only in trailing
    # newlines clean. cmp against the same bytes the render path writes.
    if [ ! -f "$out" ] || ! printf '%s' "$rendered" | cmp -s - "$out"; then
      echo "STALE: $out"
      STALE=$((STALE + 1))
    fi
  else
    printf '%s' "$rendered" > "$out"
  fi
done

if [ "$CHECK_ONLY" -eq 1 ]; then
  echo "checked: $TOTAL skills with .tmpl, $STALE stale"
  if [ "$STALE" -gt 0 ]; then
    exit 1
  fi
  exit 0
fi

echo "rendered: $TOTAL skills"
